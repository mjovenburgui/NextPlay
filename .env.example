# Copia este archivo a .env y ajusta los valores.
DJANGO_DEBUG=1
# Obligatoria cuando DJANGO_DEBUG no es 1.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# Vacía = SQLite local. En producción: postgres://usuario:clave@host:5432/nextplay
DATABASE_URL=

# Credenciales de una aplicación de Twitch (https://dev.twitch.tv/console/apps) para importar de IGDB.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Clave de https://isthereanydeal.com/apps/my/ para mostrar precios por tienda. País en ISO de 2 letras.
ITAD_API_KEY=
ITAD_COUNTRY=ES

# Clave de la Web API de Steam (https://steamcommunity.com/dev/apikey) para importar los juegos de las
# cuentas vinculadas. Vincular la cuenta no la necesita.
STEAM_API_KEY=

# Aplicación de Azure para importar los juegos de Xbox (https://portal.azure.com › Registros de
# aplicaciones). URI de redirección (Web): http://localhost:8000/cuenta/xbox/vuelta/
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
